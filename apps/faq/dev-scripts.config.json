{
  "i18n": {
    "locales": ["en"],
    "defaultLocale": "en",
    "messageRoot": "messages",
    "messageGlobs": [
      "messages/{locale}.json",
      "messages/biz/*.{locale}.json"
    ]
  },
  "scan": {
    "include": ["src/**/*.{tsx,ts,jsx,js}"],
    "exclude": ["src/**/*.test.ts", "src/**/*.test.tsx", "src/**/*.d.ts", "node_modules/**", ".claude/**", ".gemini/**", ".codex/**", ".vscode/**", ".clerk/**"],
    "includeWindrunPackages": false,
    "whitelist": ["footer.title", "home.email", "home.banner"],
    "namespaceWhitelist": [
      "usage",
      "credit",
      "gallery",
      "faq",
      "moneyPrice",
      "features",
      "tips",
      "seoContent",
      "cta",
      "languageDetection",
      "footer",
      "clerk",
      "fuma",
      "pricePlan"
    ]
  },
  "blog": {
    "mdxDir": "src/mdx/blog",
    "outputFile": "index.mdx",
    "metaFile": "meta.json",
    "iocSlug": "ioc",
    "prefix": "blog"
  },
  "output": {
    "logDir": "logs",
    "verbose": false
  },
  "architectureConfig": {
    ".": "Answers Universe Web"
  },
  "architectureExclude": [
    "server"
  ]
}
